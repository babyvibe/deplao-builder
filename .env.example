# Deplao Web gateway
# Copy to .env and load it in the shell before running `npm run web`.
# Never commit real passwords, tokens, cookies, or OAuth secrets.

# Required for browser mode. Use a long, random value (at least 12 characters).
DEPLAO_WEB=1
DEPLAO_WEB_PASSWORD=replace-with-a-long-random-password

# Optional. The gateway binds to 127.0.0.1 only.
DEPLAO_WEB_PORT=27800

# Required behind an HTTPS reverse proxy. Include scheme and port if non-standard.
# DEPLAO_WEB_ORIGIN=https://deplao.example.com
# DEPLAO_WEB_SECURE=1

# Build/runtime settings
NODE_ENV=production
BUILD_TARGET=production

# Keep these enabled for Electron/WebSocket compatibility.
WS_NO_BUFFER_UTIL=1
WS_NO_UTF_8_VALIDATE=1

# Optional diagnostics
# DEPLAO_PROFILE_STARTUP=1
# TELEGRAM_VERBOSE_LOGGING=0
# DEPLAO_KEEP_MOBILE_SYNC_FILES=0

# Optional cloud/tunnel integrations
# TUNNEL_TOKEN=
# CLOUDFLARED_VERSION=
# DEPLAO_GOOGLE_CLIENT_ID=
# DEPLAO_GOOGLE_CLIENT_SECRET=

# Optional public API / webhook documentation examples
# DEPLAO_KEY=
# DEPLAO_WEBHOOK_SECRET=

# Connector node mode (khi Deplao chạy cùng CGW)
# CGW_URL=http://127.0.0.1:8088
# CGW_NODE_TOKEN=change-this-node-token
# CGW_NODE_ID=node-01
# CGW_NODE_NAME=VPS-01
# CGW_POLL_SECONDS=2

# Optional plugin runtime variables (normally set internally by Deplao)
# DEPLAO_PLUGIN_DATA_DIR=
# DEPLAO_PLUGIN_DEV=0
# DEPLAO_PLUGIN_DIR=
# DEPLAO_PLUGIN_ENTRY=
# DEPLAO_PLUGIN_ID=
